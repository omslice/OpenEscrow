{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openescrow-landing",
  "account_id": "ac83ad901f0f00358a9b59e81487d354",
  "main": "worker.js",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "openescrow-landing-staging",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        }
      }
    }
  }
}
