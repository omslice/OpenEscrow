BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ESCROW_ADDRESS=0x1886b3322ea37134209fa40dfd592f2aaf14c329
OPERATIONS_RESERVE_ADDRESS=0xbAC6ae3f3Fdb9f4650E2c3166Ad9b918C7e4eac7
TOKEN_ADDRESS=0xE129b23BD89904D363ba226eE52deC74185D7789
YIELD_TOKEN_ADDRESS=0x2746034FF16371A65c133016470f85535992dabC
# Optional: point to a self-hosted Photon instance for production-scale address lookup.
GEOCODER_BASE_URL=https://photon.komoot.io
# Enables the daily rotating official-source change detector. It records only
# source signatures and status metadata in D1, never agreement or tenant data.
COMPLIANCE_SOURCE_MONITOR_ENABLED=true
# Contract deployment uses a Foundry encrypted keystore account. Never put a
# deployer private key in this file; see docs/base-sepolia-deployment.md.
PINATA_JWT=your-server-side-pinata-jwt
# Use private-r2 for the pilot. Switch to encrypted-ipfs only after configuring
# both a Pinata JWT and a stable 32-byte master key.
EVIDENCE_STORAGE_MODE=private-r2
EVIDENCE_ENCRYPTION_KEY=base64_encoded_32_byte_key
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
RESEND_API_KEY=re_your_server_side_key
NOTIFICATION_FROM_EMAIL=OpenEscrow <notifications@your-verified-domain.example>
# Optional provider-neutral alternative. The endpoint receives a JSON email
# envelope and must return {"id":"provider-message-id"}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
PUBLIC_APP_URL=https://openescrow-demo.omrigross.chatgpt.site/
