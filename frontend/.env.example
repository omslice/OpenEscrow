# Public client identifier from the Privy dashboard. This is not a secret.
# Leave unset to retain OpenEscrow's direct injected-wallet fallback.
VITE_PRIVY_APP_ID=

# Real card/bank funding must target a supported mainnet stablecoin. Keep this
# disabled for Base Sepolia, where the free faucet remains the funding method.
VITE_FIAT_ONRAMP_ENABLED=false
VITE_FIAT_ONRAMP_ENVIRONMENT=sandbox
VITE_FIAT_ONRAMP_CHAIN=eip155:8453
VITE_FIAT_ONRAMP_ASSET=usdc

# Production requires a second explicit release gate. Leave false until the
# mainnet contracts, legal/provider approvals, and independent security review
# are all complete.
VITE_FIAT_ONRAMP_PRODUCTION_APPROVED=false
